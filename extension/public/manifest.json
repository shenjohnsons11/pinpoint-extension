{
  "manifest_version": 3,
  "name": "PinPoint - Document Reviewer & Maker Annotations",
  "version": "1.0.0",
  "description": "Annotate Google Docs, Sheets, or PDFs in browser with text highlights, cell-clicks, and freehand gestures.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "http://localhost:4000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PinPoint Notes"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "file://*/*.pdf",
        "*://*/*.pdf"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
